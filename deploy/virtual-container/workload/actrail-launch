#!/bin/sh
# Required-mode workload launcher for the guest-root AcTrail daemon.
# It may be the container main process: it replaces itself with actrailctl, so
# the launch exit status is the container exit status. The sandbox VM stops as
# soon as that process exits, so actrailctl is told to return only after the
# Guest daemon finalized the trace and its export plugins sent the last records.
set -eu

ROOT="${ACTRAIL_WORKLOAD_ROOT:-/opt/actrail}"
"$ROOT/bin/verify-interface"

exec "$ROOT/bin/actrailctl-private" \
  --config "$ROOT/etc/actrail/operator.conf" \
  launch \
  --seccomp-notify disabled \
  --exit-settle \
  "$@"
