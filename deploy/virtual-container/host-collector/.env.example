# Development default: listen on every host interface so the Kata guest can reach it.
# Restrict this with host firewall rules and use a dedicated reachable address when possible.
OTELCOL_OTLP_HTTP_ENDPOINT=0.0.0.0:4318

# This directory must exist and be writable by uid:gid 10001:10001.
OTELCOL_DATA_DIR=/var/lib/actrail/otelcol
