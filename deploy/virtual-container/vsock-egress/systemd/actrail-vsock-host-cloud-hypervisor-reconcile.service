[Unit]
Description=Reconcile AcTrail Cloud Hypervisor VSOCK bridges with live Kata sandboxes
# The path unit starts this oneshot on every change under /run/vc/vm. With the
# default start limit (5 starts in 10 seconds) a burst of sandbox starts and
# stops fails this unit and then the path unit for good, and no later sandbox
# gets a bridge. Reconciliation is idempotent and cheap, so do not rate-limit it.
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/actrail-vsock-egress/ch-reconcile.sh
# Reconciliation only starts and stops per-sandbox bridge instances; the bridges
# themselves carry the byte-forwarding sandbox.
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
LockPersonality=true
MemoryDenyWriteExecute=true
UMask=0077
MemoryMax=32M
TasksMax=16
