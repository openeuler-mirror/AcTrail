@startuml
!include <C4/C4_Context>

skinparam defaultFontName "WenQuanYi Micro Hei"

title AcTrail - System Context (C4 Level 1)

LAYOUT_LEFT_RIGHT()

Person(Operator, "运维 / 安全操作员", "初始化配置、启动守护进程、launch 被观测任务、管理插件")
Person(Analyst, "安全分析师 / 审计员", "查询 trace、核对证据、查看告警与治理决策")
Person(ObservedAgent, "被观测 LLM Agent", "claude-code、xiaoO、opencode、codex、LangGraph 等真实 Agent 进程树")

System_Ext(LlmProvider, "LLM 提供商", "DeepSeek、Anthropic、OpenAI 兼容等远端模型服务")
System_Ext(LinuxKernel, "Linux 内核", "提供 eBPF/tracefs、seccomp user-notify、fanotify 等观测与治理内核设施")
System_Ext(OtelCollector, "OTEL Collector / 可观测后端", "接收 AcTrail 导出的语义动作 spans")
System_Ext(ClusterCenter, "集群上报中心", "接收 actrailcluster 上传的离线 trace bundle（可选部署）")

System_Boundary(actrail_boundary, "AcTrail") {
    System(AcTrail, "AcTrail", "Linux/WSL 上的 AI Agent 行为观测与治理系统：记录 agent 进程树真实行为（进程、文件、IPC、网络、TLS 明文、LLM 请求/响应），把低层证据链接到语义动作，并提供插件化治理控制与 OTLP 导出")
}

Rel(Operator, AcTrail, "初始化、启动、launch 被观测任务、加载插件", "actraild / actrailctl")
Rel(Analyst, AcTrail, "查询 trace、证据、告警与治理决策", "actrailweb / actrailviewer")
Rel(AcTrail, ObservedAgent, "观测进程树真实行为并施加治理", "eBPF / seccomp / fanotify / TLS-sync")
Rel(ObservedAgent, LlmProvider, "发出 LLM 请求并消费响应", "HTTPS / SSE / HTTP/2")
Rel(AcTrail, LinuxKernel, "挂载探针、读取事件、施加策略", "eBPF / seccomp / fanotify")
Rel(AcTrail, OtelCollector, "导出语义动作 spans", "OTLP")
Rel(AcTrail, ClusterCenter, "上传离线 trace bundle（可选）", "HTTP")

SHOW_LEGEND()
@enduml
