@startuml
!include <C4/C4_Component>

skinparam defaultFontName "WenQuanYi Micro Hei"

title actrail-vsock-gateway - Component Diagram (Execution Isolation)

LAYOUT_LEFT_RIGHT()

Container_Ext(Sb, "actrail-sb", "Guest 采集器", "一个 Guest kernel 最多一个实例")
Container_Ext(Vmm, "VMM VSOCK Bridge", "Firecracker（主线）/ Cloud Hypervisor（可选）", "将Guest AF_VSOCK映射到Host listener")
Container_Ext(Daemon, "actraild / Gateway Ingest", "Rust daemon", "接收多个 gateway TCP 上游")

Container_Boundary(gateway, "actrail-vsock-gateway（Host）") {

    Component(Listener, "Guest Link Listener", "Kernel VSOCK / Unix stream", "持有startup factory构造的物理listener并接受有界并发连接")

    Component(Session, "SB Session Registry", "连接级 u32 ID 与有界配额", "完成 SB hello/welcome，分配并在断连时清除 sb-id")

    Component(Forwarder, "Bounded Forwarder", "ForwardedSbFrame envelope", "在 upstream payload 中包裹 4-byte sb-id 与完整原始 SB frame")

    Component(Upstream, "TCP Upstream", "单连接 binary protocol", "完成 gateway hello/welcome、空 heartbeat 和有界重连")
}

Rel(Sb, Vmm, "连接 / 上报", "Guest AF_VSOCK binary frames")
Rel(Vmm, Listener, "桥接连接 / 上报", "Host AF_UNIX stream")
Rel(Sb, Listener, "可选：绕过VMM bridge直接连接", "Host Kernel AF_VSOCK")
Rel(Listener, Session, "建立 SB connection owner")
Rel(Session, Forwarder, "有效 ObservationBatch frame + sb-id")
Rel(Forwarder, Upstream, "有界 ForwardedSbFrame")
Rel(Upstream, Daemon, "hello / heartbeat / forwarded frame", "TCP binary frames")

note right of Forwarder
  不解码 observation payload
  不做插件匹配、关联或持久化
  单 SB 故障不终止其他会话
end note

SHOW_LEGEND()
@enduml
