@startuml
!include <C4/C4_Component>

skinparam defaultFontName "WenQuanYi Micro Hei"

title actraild (Brain Side) - Component Diagram (Execution Isolation)

LAYOUT_LEFT_RIGHT()

Container_Ext(TlsSync, "TLS-sync Runtime（脑侧）", "LD_PRELOAD 共享库", "注入大脑进程，上报明文 payload")
System_Ext(Brain, "大脑 Brain", "Agent 核心运行时（平台受控区）")
Container_Ext(Gateway, "actrail-vsock-gateway", "Host VSOCK-to-TCP proxy", "复用一条 TCP 上游转发多个 SB 的原始 observation frames")
System_Ext(Kernel, "Linux 内核（脑侧）", "eBPF / tracefs / seccomp")
ContainerDb(Storage, "AcTrail Storage", "SQLite (WAL)", "事件、payload、语义动作、诊断、告警")
ContainerDb(SandboxEvidenceDb, "Sandbox Evidence DB", "独立 SQLite 数据库", "仅保存无插件消费意向的手侧原始观测；独立 schema、文件与生命周期")
Container_Ext(PluginPkg, "Plugin Packages", "Builtin / WASM 插件包", "既有插件 + sandbox raw-observation selectors/consumers")
System_Ext(Platform, "外部平台", "OTEL Collector / 集群中心")

Container_Boundary(actraild, "actraild（脑侧）") {

    Component(Attach, "Attach Service", "attach", "eBPF 挂载、coverage guard、launch 权限裁决")

    Component(Ebpf, "eBPF Collector（脑侧）", "adapters/collectors/ebpf", "大脑侧进程 / 文件 / socket / stdio / TLS 密钥采集")

    Component(TlsIngest, "TLS Sync Service", "services/tls_sync", "接收大脑侧 TLS-sync 明文 payload 与连接事件")

    Component(Payload, "Payload Service", "services/payload", "收集 RawPayloadSegment、敏感内容门控、分发明文 payload")

    Component(AppProto, "Application Protocol", "application_protocol", "在明文 payload 上做 HTTP/1.1 / HTTP/2 / SSE 语义分析")

    Component(Seccomp, "Seccomp Services", "seccomp_notify / process_seccomp", "大脑侧 execve 上下文、子进程跟踪")

    Component(Governance, "Governance", "enforcement / command_control / network_control", "文件治理、命令管控、网络管控")

    Component(HandListener, "Hand Observation TCP Listener", "独立 listener thread", "监听 gateway TCP 地址并为每条已接受连接创建独立 worker")

    Component(GatewayWorker, "Gateway Connection Worker", "每连接独立 thread", "顺序完成 hello/welcome、空 heartbeat、frame 校验与当前连接 gateway-id 生命周期")

    Component(GatewayIngest, "Gateway Ingest Runtime", "gateway_ingest_runtime", "逐 observation 读取 immutable interest snapshot；投递全部匹配插件；仅 NoInterest 写独立数据库")

    Component(Identity, "Identity Manager", "identity / process_identity", "多坐标解析稳定逻辑进程 ID")

    Component(Trace, "Trace Runtime", "trace_runtime", "trace 注册表、membership 进程树、生命周期状态机")

    Component(Ingest, "Ingest Pipeline", "ingest_runtime", "normalize → policy gate → provider classify")

    Component(Semantic, "Semantic Action Runtime", "semantic_actions", "live 投影器：agent / command / file / http_exchange / mcp / tool / links")

    Component(Llm, "LLM Pipeline", "llm_pipeline", "消费全部来源明文 payload（TLS-sync / socket / stdio）：HTTP/SSE/provider 解析、llm.codec 解码、tool 投影")

    Component(Writer, "Recording Writer", "recording/runtime", "单事务持久化（BEGIN IMMEDIATE）")

    Component(Export, "Export Runtime", "export/core", "BestEffort 路由分发语义动作")

    Component(PluginHost, "Plugin Host", "plugin_system / plugin_wasm_runtime", "immutable sandbox interest snapshot、全部匹配的有界 raw-observation consumers 与资源告警插件")

    Component(Alert, "Alert Ingress", "alert_ingress", "告警 broker：boundary 告警与插件告警的校验、dedup、入队列")
}

Rel(Attach, Ebpf, "挂载与绑定 trace")
Rel(Attach, Trace, "创建 trace、注册绑定")

Rel(Ebpf, Brain, "观测大脑侧行为", "eBPF / seccomp")
Rel(Kernel, Ebpf, "ring buffer 事件流", "eBPF")
Rel(Kernel, Seccomp, "user-notify 事件", "seccomp")
Rel(Kernel, Governance, "fanotify / execve / connect 事件", "内核")

Rel(TlsSync, TlsIngest, "上报明文 payload", "UDS")

Rel(Gateway, HandListener, "gateway hello / 空 heartbeat / ForwardedSbFrame", "TCP binary frames")
Rel(HandListener, GatewayWorker, "每条已接受连接移交独立 worker")
Rel(GatewayWorker, GatewayIngest, "校验后的 observation batch + 当前连接来源标记")

Rel(Ebpf, Payload, "socket / stdio payload", "Syscall / Stdio")
Rel(TlsIngest, Payload, "TLS payload", "TlsUserSpace")
Rel(Payload, Llm, "PayloadSegment 流（分支：TlsUserSpace / Syscall 来源且 Plaintext 才进投影）")
Rel(Payload, AppProto, "明文 payload", "Plaintext")
Rel(AppProto, Llm, "HTTP exchange / SSE 语义")

Rel(Ebpf, Ingest, "RawCollectorEvent")
Rel(Seccomp, Ingest, "进程事件")
Rel(Governance, Ingest, "Enforcement 事件")
Rel(Identity, Ingest, "逻辑进程身份")
Rel(Trace, Ingest, "membership 匹配结果")

Rel(Ingest, Identity, "提交观测、请求身份解析")
Rel(Ingest, Trace, "查询 membership 匹配")
Rel(Ingest, Semantic, "DomainEvent")

Rel(Llm, Semantic, "llm.request / llm.response / tool 投影")

Rel(Semantic, Writer, "SemanticAction + links")
Rel(Semantic, Alert, "boundary 告警（文件访问越界等）")
Rel(Semantic, Export, "发布 SemanticActionExportBatch")

Rel(PluginHost, Alert, "插件 alert-write 提交（activity-anomaly / tool-failure-alert）")
Rel(PluginHost, Export, "observation consumer 注册")
Rel(GatewayIngest, PluginHost, "批量读取 immutable interest snapshot；向全部匹配 consumers 投递")
Rel(GatewayIngest, SandboxEvidenceDb, "仅成功返回 NoInterest：批量写入独立数据库", "SQLite")
Rel(PluginHost, Governance, "control-decider 决策")
Rel(PluginHost, PluginPkg, "加载", "Builtin / Wasmtime")

Rel(Writer, Storage, "单事务写入", "SQLite")
Rel(Alert, Storage, "写入告警", "SQLite")

note right of GatewayIngest
  不进入 Ingest Pipeline
  不做 trace / identity / semantic 关联
  匹配插件：投递全部匹配目标
  NoInterest：仅写独立数据库
  query / delivery / DB failure 均不跨分支 fallback
end note

Rel(Export, Platform, "导出", "OTLP / HTTP")

SHOW_LEGEND()
@enduml
