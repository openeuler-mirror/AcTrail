@startuml
!include <C4/C4_Context>

skinparam defaultFontName "WenQuanYi Micro Hei"

title AcTrail - System Context (C4 Level 1, Execution Isolation)

LAYOUT_LEFT_RIGHT()

Person(Operator, "运维 / 安全操作员", "管理平台受控区、编排沙箱生命周期")
Person(Analyst, "安全分析师 / 审计员", "查询 trace、核对证据、查看告警与治理决策")

System_Boundary(brain_side, "脑侧（平台受控区）") {
    System_Ext(Brain, "大脑 Brain", "Agent 核心运行时：LLM 推理 · 记忆 · 规划 · 凭证与策略管理")
}

System_Boundary(hand_side, "手侧（执行沙箱）") {
    System_Ext(Hand, "Guest Agent / workload", "沙箱内真实 Agent 与动作执行环境：工具调用 · 代码执行 · 文件 / 网络操作")
}

System(AcTrail, "AcTrail", "Agent 行为观测与治理系统：actraild（脑侧）+ actrail-sb（手侧）+ vsock gateway（宿主）")

System_Ext(LlmProvider, "LLM 提供商", "DeepSeek、Anthropic、OpenAI 兼容等远端模型服务")
System_Ext(BrainKernel, "Linux kernel（脑侧）", "actraild 使用的 eBPF / tracefs / seccomp 观测与治理设施")
System_Ext(GuestKernel, "Linux Guest kernel（手侧）", "actrail-sb 独立拥有的 Guest-side eBPF、map、attach point 与 procfs")
System_Ext(Platform, "外部平台", "OTEL Collector / 集群中心 / 可观测后端")

Rel(Operator, AcTrail, "管理平台受控区与网关", "actraild service lifecycle")
Rel(Analyst, AcTrail, "查询 trace、证据、告警与治理决策", "actrailweb / actrailviewer")
Rel(AcTrail, Brain, "观测大脑侧行为", "eBPF / seccomp")
Rel(AcTrail, Hand, "采集目标进程谱系 I/O 与 Guest 资源快照", "Guest-only eBPF / procfs / vsock")
Rel(Brain, LlmProvider, "发出 LLM 请求并消费响应", "HTTPS / SSE / HTTP/2")
Rel(AcTrail, BrainKernel, "挂载脑侧探针、读取脑侧事件", "eBPF / seccomp")
Rel(AcTrail, GuestKernel, "独立采集根进程谱系 I/O 与 Guest 资源", "Guest-side eBPF / procfs")
Rel(AcTrail, Platform, "导出语义动作", "OTLP")

SHOW_LEGEND()
@enduml
