@startuml
!include <C4/C4_Container>

title AcTrail LLM Streaming Parser - Container Diagram

LAYOUT_LEFT_RIGHT()

Person(Agent, "LLM Agent", "Pi、xiaoO、Claude、Codex 等被观测进程")
System_Ext(ModelService, "Remote LLM Service", "OpenAI-compatible、OpenAI Responses、Anthropic 或自定义服务")

System_Boundary(AcTrail, "AcTrail") {
    Container(PayloadCapture, "Payload Capture Runtime", "TLS/socket probes", "采集双向 plaintext payload、operation、sequence 与进程上下文")
    Container(PayloadIngress, "Payload Ingress", "Daemon service", "校验并持久化低层 payload，将完整 segment 交给语义运行时")
    Container(StreamingParser, "Streaming Parser Pipeline", "semantic_action_runtime", "facade 编排 assembly、transport、SSE framing、provider semantics 与 projection")
    Container(HttpExchange, "HTTP Exchange Runtime", "semantic_action_runtime", "维护 HTTP request/response identity、H2 stream_id 与 confirmed exchange")
    Container(ActionProjector, "HTTP-aware Action Projector", "semantic_action_runtime", "生成 llm.request、llm.response、llm.call、evidence 与 links")
    ContainerDb(Storage, "Semantic Storage", "SQLite/storage adapters", "保存 payload、actions、links、diagnostics 与 retention 产物")
    Container(Config, "Runtime Configuration", "config_core", "提供 assembly、classification、retention 和 diagnostics 限制")
    Container(ViewExport, "Viewer and Export", "CLI/Web/OTel/plugins", "查询、展示并导出已持久化语义动作")
}

Rel(Agent, ModelService, "发送请求并消费流式响应", "HTTPS / HTTP/2 / SSE")
Rel(PayloadCapture, Agent, "观测进程内 plaintext 与 socket 数据")
Rel(PayloadCapture, PayloadIngress, "发送 PayloadSegment", "UDS / event transport")
Rel(PayloadIngress, StreamingParser, "提交有序 payload segment")
Rel(PayloadIngress, HttpExchange, "提交 HTTP request/response observation")
Rel(Config, StreamingParser, "提供有界 parser 配置")
Rel(Config, ActionProjector, "提供 semantic retention 配置")
Rel(StreamingParser, ActionProjector, "提交 ProviderStreamUpdate、complete/partial response 与 evidence snapshot")
Rel(HttpExchange, ActionProjector, "提供 HTTP context、stream_id 与 exchange identity")
Rel(ActionProjector, Storage, "持久化 actions、links 与 payload drafts")
Rel(PayloadIngress, Storage, "持久化低层 payload 与 compact diagnostics")
Rel(Storage, ViewExport, "提供查询和导出数据")

SHOW_LEGEND()
@enduml
