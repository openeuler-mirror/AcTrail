@startuml
!include <C4/C4_Container>

title AcTrail Live Tool Projector - Container Context

LAYOUT_LEFT_RIGHT()

Person(ObservedAgent, "Observed LLM Agent", "Claude、xiaoO、OpenCode 等被观测进程")
System_Ext(ModelService, "Remote LLM Service", "返回普通或流式 LLM 响应和 tool calls")

System_Boundary(AcTrail, "AcTrail") {
    Container(CaptureRuntime, "Payload Capture Runtime", "TLS/socket probes", "采集进程内 payload 与连接生命周期；不理解 tool 语义")
    Container(LlmPipeline, "LLM Action Pipeline", "semantic_action_runtime::llm_pipeline", "完成 HTTP/SSE/provider 解析，输出标准化 LLM actions、tool results 与 lineage context")
    Container(LiveRuntime, "Live Semantic Action Runtime", "semantic_action_runtime::live", "组合各语义投影器；内部持有 Live Tool Projector，管理 observe/finalize/forget 生命周期")
    ContainerDb(SemanticStorage, "Semantic Storage", "storage adapters", "持久化 SemanticAction、SemanticActionLink 与 diagnosis events")
    Container(RuntimeConfig, "Runtime Configuration", "config_core", "提供 agent invocation policy 与每 trace 有界状态容量")
    Container(ExportSurface, "Query and Export", "CLI/Web/OTel/plugins", "查询、展示和导出语义动作及诊断")
}

Rel(ObservedAgent, ModelService, "发出 LLM 请求并消费响应", "HTTPS / SSE / HTTP/2")
Rel(CaptureRuntime, ObservedAgent, "观测 plaintext payload 和连接事件")
Rel(CaptureRuntime, LlmPipeline, "提交有序 payload、gap、close 与 trace 生命周期")
Rel(LlmPipeline, LiveRuntime, "提交标准化 ActionBatch", "llm.request / llm.response / projected tool result / lineage context")
Rel(RuntimeConfig, LiveRuntime, "构造时提供已验证的 tool projection 配置")
Rel(LiveRuntime, SemanticStorage, "输出 actions、links 与 diagnosis events")
Rel(SemanticStorage, ExportSurface, "提供查询和导出数据")

note right of LiveRuntime
  Live Tool Projector 是该容器内部组件，不是独立部署单元。

  职责：
  * 跨批次关联 tool call、tool result 与 agent invocation
  * 物化 tool-specific actions、links 与 diagnosis events
  * 有界保存关联状态并在 trace 结束时确定性清理

  非职责：
  * TLS/socket、HTTP、SSE 或 provider codec 解析
  * 持久化、导出或全局 trajectory 决策
end note

SHOW_LEGEND()
@enduml
