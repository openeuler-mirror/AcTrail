{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "actrail.llm-turn-anomaly.repeated-similar.payload.v1",
  "type": "object",
  "required": [
    "root_process_id",
    "display_name",
    "profile_name",
    "similarity_window",
    "similarity_tolerance_ratio_per_mille",
    "min_repeat_count",
    "findings",
    "truncated_count"
  ],
  "properties": {
    "root_container_id": { "type": ["string", "null"] },
    "root_process_id": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "profile_name": { "type": "string", "minLength": 1 },
    "similarity_window": { "type": "integer", "minimum": 2 },
    "similarity_tolerance_ratio_per_mille": { "type": "integer", "minimum": 0 },
    "min_repeat_count": { "type": "integer", "minimum": 2 },
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "required": [
          "process_id",
          "model",
          "repeat_count",
          "representative_action_id",
          "representative_request_bytes",
          "first_started_at_ms",
          "last_started_at_ms"
        ],
        "properties": {
          "process_id": { "type": "string", "minLength": 1 },
          "model": { "type": ["string", "null"] },
          "repeat_count": { "type": "integer", "minimum": 2 },
          "representative_action_id": { "type": "string", "minLength": 1 },
          "representative_request_bytes": { "type": "integer", "minimum": 0 },
          "first_started_at_ms": { "type": "integer", "minimum": 0 },
          "last_started_at_ms": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "truncated_count": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
