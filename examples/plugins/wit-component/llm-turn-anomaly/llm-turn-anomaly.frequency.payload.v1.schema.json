{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "actrail.llm-turn-anomaly.frequency.payload.v1",
  "type": "object",
  "required": [
    "root_process_id",
    "display_name",
    "profile_name",
    "window_size_ms",
    "threshold",
    "findings",
    "truncated_count"
  ],
  "properties": {
    "root_container_id": { "type": ["string", "null"] },
    "root_process_id": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "profile_name": { "type": "string", "minLength": 1 },
    "window_size_ms": { "type": "integer", "minimum": 1 },
    "threshold": { "type": "integer", "minimum": 1 },
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "required": [
          "process_id",
          "model",
          "exchange_count",
          "window_start_ms",
          "window_end_ms"
        ],
        "properties": {
          "process_id": { "type": "string", "minLength": 1 },
          "model": { "type": ["string", "null"] },
          "exchange_count": { "type": "integer", "minimum": 1 },
          "window_start_ms": { "type": "integer", "minimum": 0 },
          "window_end_ms": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "truncated_count": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
