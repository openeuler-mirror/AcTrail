{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "actrail.llm-turn-anomaly.error-ratio.payload.v1",
  "type": "object",
  "required": [
    "root_process_id",
    "display_name",
    "profile_name",
    "minimum_exchanges",
    "error_ratio_per_mille",
    "window_size",
    "findings",
    "truncated_count"
  ],
  "properties": {
    "root_container_id": { "type": ["string", "null"] },
    "root_process_id": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "profile_name": { "type": "string", "minLength": 1 },
    "minimum_exchanges": { "type": "integer", "minimum": 1 },
    "error_ratio_per_mille": { "type": "integer", "minimum": 1 },
    "window_size": { "type": "integer", "minimum": 1 },
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "required": [
          "process_id",
          "model",
          "total_exchanges",
          "error_count",
          "actual_ratio_per_mille"
        ],
        "properties": {
          "process_id": { "type": "string", "minLength": 1 },
          "model": { "type": ["string", "null"] },
          "total_exchanges": { "type": "integer", "minimum": 1 },
          "error_count": { "type": "integer", "minimum": 1 },
          "actual_ratio_per_mille": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "truncated_count": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
