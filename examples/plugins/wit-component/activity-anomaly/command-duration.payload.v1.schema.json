{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "actrail.activity-anomaly.command-duration.payload.v1",
  "type": "object",
  "required": [
    "root_process_id",
    "display_name",
    "profile_name",
    "maximum_duration_ms",
    "findings",
    "truncated_count"
  ],
  "properties": {
    "root_container_id": { "type": ["string", "null"] },
    "root_process_id": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "profile_name": { "type": "string", "minLength": 1 },
    "maximum_duration_ms": { "type": "integer", "minimum": 1 },
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "required": [
          "action_id",
          "process_id",
          "started_at_ms",
          "observed_at_ms",
          "ended_at_ms",
          "duration_ms",
          "status"
        ],
        "properties": {
          "action_id": { "type": "string", "minLength": 1 },
          "process_id": { "type": "string", "minLength": 1 },
          "executable": { "type": ["string", "null"] },
          "command_line": { "type": ["string", "null"] },
          "started_at_ms": { "type": "integer", "minimum": 0 },
          "observed_at_ms": { "type": "integer", "minimum": 0 },
          "ended_at_ms": { "type": ["integer", "null"], "minimum": 0 },
          "duration_ms": { "type": "integer", "minimum": 0 },
          "status": { "type": "string", "minLength": 1 },
          "exit_code": { "type": ["integer", "null"] },
          "agent_action_id": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "truncated_count": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
