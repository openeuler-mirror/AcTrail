{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "actrail.activity-anomaly.llm-growth.payload.v1",
  "type": "object",
  "required": [
    "direction",
    "root_process_id",
    "display_name",
    "profile_name",
    "window_size",
    "minimum_samples",
    "ratio_per_mille",
    "minimum_growth_bytes",
    "minimum_current_bytes",
    "hard_limit_bytes",
    "findings",
    "truncated_count"
  ],
  "properties": {
    "direction": { "enum": ["request", "response"] },
    "root_container_id": { "type": ["string", "null"] },
    "root_process_id": { "type": "string", "minLength": 1 },
    "display_name": { "type": "string", "minLength": 1 },
    "profile_name": { "type": "string", "minLength": 1 },
    "window_size": { "type": "integer", "minimum": 1, "maximum": 64 },
    "minimum_samples": { "type": "integer", "minimum": 1, "maximum": 64 },
    "ratio_per_mille": { "type": "integer", "minimum": 1001 },
    "minimum_growth_bytes": { "type": "integer", "minimum": 1 },
    "minimum_current_bytes": { "type": "integer", "minimum": 1 },
    "hard_limit_bytes": { "type": "integer", "minimum": 1 },
    "findings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "required": [
          "action_id",
          "call_action_id",
          "process_id",
          "observed_bytes",
          "reason",
          "started_at_ms"
        ],
        "properties": {
          "action_id": { "type": "string", "minLength": 1 },
          "call_action_id": { "type": "string", "minLength": 1 },
          "process_id": { "type": "string", "minLength": 1 },
          "model": { "type": ["string", "null"] },
          "server_address": { "type": ["string", "null"] },
          "url_path": { "type": ["string", "null"] },
          "observed_bytes": { "type": "integer", "minimum": 0 },
          "baseline_median_bytes": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "observed_ratio_per_mille": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "reason": { "enum": ["hard-limit", "relative-growth"] },
          "started_at_ms": { "type": "integer", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "truncated_count": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
